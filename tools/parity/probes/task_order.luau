-- The task library's order: spawn, defer, delay, wait and cancel, nested, and the order threads resume in.
local RunService = game:GetService("RunService")
P.sync()

local Log = {}
local function Note(Text)
	table.insert(Log, Text)
end
local Frame = 0
local FrameConnection = RunService.Heartbeat:Connect(function()
	Frame += 1
	Note("hb" .. Frame)
end)

-- 1. nesting from a scheduler resumption
Note("start")
task.spawn(function()
	Note("spawn1")
	task.defer(function()
		Note("defer-in-spawn1")
		task.defer(function()
			Note("defer-in-defer")
		end)
		task.spawn(function()
			Note("spawn-in-defer")
		end)
	end)
	task.spawn(function()
		Note("spawn-in-spawn1")
	end)
	Note("spawn1-end")
end)
task.defer(function()
	Note("defer1")
end)
task.defer(function()
	Note("defer2")
	task.defer(function()
		Note("defer-in-defer2")
	end)
end)
task.delay(0, function()
	Note("delay0")
end)
task.spawn(function()
	task.wait()
	Note("wait-in-spawn")
end)
task.defer(function()
	task.wait()
	Note("wait-in-defer")
end)
Note("end-of-block")
task.wait()
Note("after-wait-1")
task.wait()
Note("after-wait-2")
print("nesting " .. table.concat(Log, ","))
table.clear(Log)

-- 2. threads that become ready on the same frame: resumed by deadline or by the order they waited?
P.sync()
local Started = Frame
for _, Spec in { { "a", 0.07 }, { "b", 0.04 }, { "c", 0.055 }, { "d", 0.04 }, { "e", 0 } } do
	task.spawn(function()
		task.wait(Spec[2])
		Note(Spec[1] .. "@" .. (Frame - Started))
	end)
end
for _, Spec in { { "da", 0.07 }, { "db", 0.04 }, { "dc", 0.055 }, { "dd", 0.04 }, { "de", 0 } } do
	task.delay(Spec[2], function()
		Note(Spec[1] .. "@" .. (Frame - Started))
	end)
end
for _ = 1, 6 do
	task.wait()
end
print("ready-order " .. table.concat(Log, ","))
table.clear(Log)

-- 3. cancel
P.sync()
local Deferred = task.defer(function()
	Note("cancelled-defer-ran")
end)
task.cancel(Deferred)
local Delayed = task.delay(0, function()
	Note("cancelled-delay-ran")
end)
task.cancel(Delayed)
local Waiting = task.spawn(function()
	task.wait(0.02)
	Note("cancelled-wait-ran")
end)
task.cancel(Waiting)
print("status-after-cancel " .. coroutine.status(Deferred) .. " " .. coroutine.status(Delayed) .. " " .. coroutine.status(Waiting))
local SelfCancel = task.spawn(function()
	Note("self-cancel-before")
	print("cancel-self " .. P.try(task.cancel, coroutine.running()))
	Note("self-cancel-after")
end)
print("self-cancel-status " .. coroutine.status(SelfCancel))
local Normal
Normal = coroutine.create(function()
	local Inner = coroutine.create(function()
		print("cancel-normal " .. P.try(task.cancel, Normal))
	end)
	coroutine.resume(Inner)
end)
coroutine.resume(Normal)
print("cancel-dead " .. P.try(task.cancel, Normal))
print("cancel-twice " .. P.try(task.cancel, Deferred))
print("cancel-nonthread " .. P.try(task.cancel, 5))
-- a thread waiting on a signal
local Signal = Instance.new("BindableEvent")
local OnSignal = task.spawn(function()
	Signal.Event:Wait()
	Note("signal-wait-ran")
end)
task.cancel(OnSignal)
Signal:Fire()
-- defer the same thread twice, spawn a deferred one
local Twice = coroutine.create(function(...)
	Note("twice " .. select("#", ...) .. " " .. tostring((...)))
	coroutine.yield()
	Note("twice-second")
end)
print("defer-twice-first " .. P.try(task.defer, Twice, "a"))
print("defer-twice-second " .. P.try(task.defer, Twice, "b"))
print("spawn-deferred " .. P.try(task.spawn, Twice, "c"))
local DelayedThread = coroutine.create(function() end)
print("delay-then-defer " .. P.try(function()
	task.delay(0, DelayedThread)
	task.defer(DelayedThread)
end))
print("delay-twice " .. P.try(function()
	local Again = coroutine.create(function() end)
	task.delay(0, Again)
	task.delay(0, Again)
end))
task.wait()
task.wait()
print("cancel-log " .. table.concat(Log, ","))
table.clear(Log)

-- 4. what the calls return and take
P.sync()
local Co = coroutine.create(function(A, B)
	Note("co " .. tostring(A) .. " " .. tostring(B))
	local X = coroutine.yield(1)
	Note("co resumed " .. tostring(X))
end)
local Spawned = task.spawn(Co, "x", "y")
print("spawn-returns-same " .. tostring(Spawned == Co) .. " " .. coroutine.status(Co))
task.spawn(Co, "z")
print("spawn-dead " .. P.try(task.spawn, Co))
print("defer-dead " .. P.try(task.defer, Co))
print("spawn-nonfunction " .. P.try(task.spawn, 5))
print("defer-nonfunction " .. P.try(task.defer, "x"))
print("delay-nonfunction " .. P.try(task.delay, 0, nil))
print("delay-string-time " .. P.try(task.delay, "x", function() end))
print("wait-string " .. P.try(task.wait, "x"))
local Running = coroutine.running()
print("spawn-running " .. P.try(task.spawn, Running))
print("log " .. table.concat(Log, ","))
table.clear(Log)

-- 5. the values task.wait and wait hand back
P.sync()
local Elapsed = task.wait()
print("task.wait() type " .. type(Elapsed) .. " positive " .. tostring(Elapsed > 0) .. " under-frame " .. tostring(Elapsed < 0.05))
local A, B = wait()
print("wait() types " .. type(A) .. " " .. type(B) .. " a-positive " .. tostring(A > 0))
local Count = select("#", task.wait(0))
print("task.wait(0) returns " .. Count)
local NegStart = Frame
task.wait(-1)
print("task.wait(-1) frames " .. (Frame - NegStart))
local NanStart = Frame
task.wait(0 / 0)
print("task.wait(nan) frames " .. (Frame - NanStart))
local DelayFrames = {}
local DelayStart = Frame
task.delay(-5, function()
	table.insert(DelayFrames, "neg@" .. (Frame - DelayStart))
end)
task.delay(0 / 0, function()
	table.insert(DelayFrames, "nan@" .. (Frame - DelayStart))
end)
task.delay(nil, function()
	table.insert(DelayFrames, "nil@" .. (Frame - DelayStart))
end)
for _ = 1, 3 do
	task.wait()
end
print("delay-odd-times " .. table.concat(DelayFrames, ","))

-- 6. arguments pass through
P.sync()
task.spawn(function(...)
	print("spawn-args " .. select("#", ...) .. " " .. tostring(select(1, ...)) .. " " .. tostring(select(3, ...)))
end, 1, nil, 3)
task.defer(function(...)
	print("defer-args " .. select("#", ...) .. " " .. tostring(select(2, ...)))
end, nil, "two", nil)
task.delay(0, function(...)
	print("delay-args " .. select("#", ...))
end, 1, 2, 3, 4)
task.wait()
task.wait()
FrameConnection:Disconnect()
