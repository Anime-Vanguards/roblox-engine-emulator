-- The spatial queries' arguments (world/query.rs): what each of Raycast, Blockcast, Spherecast, Shapecast,
-- GetPartBoundsInBox, GetPartBoundsInRadius, GetPartsInPart and the FindPartOnRay family raises for a missing, nil or
-- wrongly typed argument (checked from the last to the first, each cast to its parameter's type), which values the casts
-- take (a bool, a numeric string), and the methods' own checks after the casts. The scene is 300 studs out: a client's
-- Workspace holds the player's character near the origin.
P.sync()
local Root = Instance.new("Folder")
Root.Parent = workspace
local Part = Instance.new("Part")
Part.Anchored = true
Part.Position = Vector3.new(300, 90, 300)
Part.Size = Vector3.new(10, 1, 10)
Part.Parent = Root
local Folder = Instance.new("Folder")
Folder.Parent = Root
local V = Vector3.new(300, 100, 300)
local D = Vector3.new(0, -1, 0)
local CF = CFrame.new(300, 100, 300)
local S = Vector3.new(1, 1, 1)
local R = Ray.new(V, Vector3.new(0, -20, 0))
local RP = RaycastParams.new()
local OP = OverlapParams.new()

local function Show(...)
	local Results = table.pack(...)
	local Parts = {}
	for Index = 1, Results.n do
		local Value = Results[Index]
		table.insert(Parts, if typeof(Value) == "Instance" then Value.Name elseif typeof(Value) == "RaycastResult" then "hit " .. Value.Instance.Name elseif type(Value) == "table" then "#" .. #Value else typeof(Value))
	end
	return table.concat(Parts, ",")
end
local function Try(Label, Method, ...)
	local Arguments = table.pack(...)
	local Results = table.pack(pcall(function()
		return workspace[Method](workspace, table.unpack(Arguments, 1, Arguments.n))
	end))
	if Results[1] then
		print(Label, "ok", Show(table.unpack(Results, 2, Results.n)))
	else
		print(Label, "error", P.err(Results[2]))
	end
end

