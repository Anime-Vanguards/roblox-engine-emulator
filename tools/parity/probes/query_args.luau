Try("fpor(R)", "FindPartOnRay", R20)
Try("fpor(R,nil)", "FindPartOnRay", R20, nil)
Try("fpor(R,Part)", "FindPartOnRay", R20, Part)
Try("fpor(R,nil,nil,nil)", "FindPartOnRay", R20, nil, nil, nil)
for _, Case in {
	{ "true", true }, { "0", 0 }, { "1", 1 }, { "'true'", "true" }, { "'1'", "1" }, { "{}", {} }, { "{1}", { 1 } }, { "part", Part }, { "V", V }, { "CF", CF },
	{ "key", Enum.KeyCode.A }, { "fn", print }, { "nan", 0 / 0 },
} do
	Try("fpor(R,nil," .. Case[1] .. ")", "FindPartOnRay", R20, nil, Case[2])
	Try("fpor(R,nil,false," .. Case[1] .. ")", "FindPartOnRay", R20, nil, false, Case[2])
end
