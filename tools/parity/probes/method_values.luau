-- Methods read as values: whether each read gives the same function (rawequal and ==), by the kind of value
P.sync()
local Event = Instance.new("BindableEvent")
local Other = Instance.new("BindableEvent")
local Signal = Event.Event
local Connection = Signal:Connect(function() end)
local V3 = Vector3.new(1, 2, 3)
local V2 = Vector2.new(1, 2)
local Cf = CFrame.new(1, 2, 3)
local C3 = Color3.new(0.1, 0.2, 0.3)
local U2 = UDim2.new(1, 2, 3, 4)
local Rng = Random.new(1)
local function Same(Label, Read)
	local First, Second = Read()
	print("same " .. Label .. " " .. tostring(rawequal(First, Second)) .. " " .. tostring(First == Second) .. " " .. type(First))
end
Same("signal.Connect self", function() return Signal.Connect, Signal.Connect end)
Same("signal.Connect again", function() return Event.Event.Connect, Event.Event.Connect end)
Same("signal.Connect other", function() return Signal.Connect, Other.Event.Connect end)
Same("signal.Once self", function() return Signal.Once, Signal.Once end)
Same("signal.Wait self", function() return Signal.Wait, Signal.Wait end)
Same("signal.ConnectParallel self", function() return Signal.ConnectParallel, Signal.ConnectParallel end)
Same("signal.connect self", function() return Signal.connect, Signal.connect end)
Same("connection.Disconnect self", function() return Connection.Disconnect, Connection.Disconnect end)
Same("connection.disconnect self", function() return Connection.disconnect, Connection.disconnect end)
Same("v3.Lerp self", function() return V3.Lerp, V3.Lerp end)
Same("v3.Lerp other", function() return V3.Lerp, Vector3.one.Lerp end)
Same("v3.Dot self", function() return V3.Dot, V3.Dot end)
Same("v3.Unit", function() return V3.Unit, V3.Unit end)
Same("v2.Lerp self", function() return V2.Lerp, V2.Lerp end)
Same("v2.Lerp other", function() return V2.Lerp, Vector2.one.Lerp end)
Same("cf.Lerp self", function() return Cf.Lerp, Cf.Lerp end)
Same("cf.Lerp other", function() return Cf.Lerp, CFrame.identity.Lerp end)
Same("cf.Inverse self", function() return Cf.Inverse, Cf.Inverse end)
Same("c3.Lerp self", function() return C3.Lerp, C3.Lerp end)
Same("c3.Lerp other", function() return C3.Lerp, Color3.new().Lerp end)
Same("u2.Lerp self", function() return U2.Lerp, U2.Lerp end)
Same("rng.NextNumber self", function() return Rng.NextNumber, Rng.NextNumber end)
Same("enumitem.IsA self", function() return Enum.Material.Plastic.IsA, Enum.Material.Plastic.IsA end)
Same("enumitem.IsA other", function() return Enum.Material.Plastic.IsA, Enum.Material.Wood.IsA end)
Same("enum.GetEnumItems self", function() return Enum.Material.GetEnumItems, Enum.Material.GetEnumItems end)
Same("enums.GetEnums self", function() return Enum.GetEnums, Enum.GetEnums end)
Same("part.Destroy self", function() return workspace.Destroy, workspace.Destroy end)
-- a signal method value still works, called on another signal
local Fired = 0
local Connect = Signal.Connect
local Made = Connect(Other.Event, function()
	Fired += 1
end)
Other:Fire()
task.wait()
print("signal.Connect other-signal " .. Fired .. " " .. typeof(Made))
Made:Disconnect()
print("v3.Lerp value " .. tostring(V3.Lerp(Vector3.zero, Vector3.one, 0.5)))
print("debug.info signal.Connect " .. table.concat({ tostring((debug.info(Signal.Connect, "s"))), tostring((debug.info(Signal.Connect, "n"))) }, " "))
print("debug.info v3.Lerp " .. table.concat({ tostring((debug.info(V3.Lerp, "s"))), tostring((debug.info(V3.Lerp, "n"))) }, " "))
Connection:Disconnect()
