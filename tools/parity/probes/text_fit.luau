-- GetTextBoundsAsync measures as GetTextSize does
local Face = Font.fromEnum(Enum.Font.FredokaOne)
for _, Case in { { "Hello", 1, 0 }, { "Hello", 20, 28 }, { "lll", 20, 12 }, { ".T", 20, 0 }, { "a b", 20, 9 }, { "WWWWW", 20, 1 }, { "Hello ", 20, 10 } } do
	local Params = Instance.new("GetTextBoundsParams")
	Params.Text, Params.Font, Params.Size, Params.Width = Case[1], Face, Case[2], Case[3]
	local Ok, Bounds = pcall(function()
		return TextService:GetTextBoundsAsync(Params)
	end)
	print("bounds", `"{Case[1]}"`, Case[2], Case[3], if not Ok then "error " .. P.err(Bounds) elseif Bounds == Size(Case[1], Case[2], Case[3]) then "as GetTextSize" else `{P.f32(Bounds.X)} {P.f32(Bounds.Y)}`)
end
