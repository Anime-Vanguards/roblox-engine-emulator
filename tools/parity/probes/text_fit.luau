-- TextService:GetTextSize of FredokaOne as a playing client lays it out: sizes 1 to 3, the font's ligatures (never broken, kerned
-- as glyphs of their own), the marks " ' , . before a text's first letter (not kerned), a word wider than the frame, a line's width
-- up to the next line's pen position, the empty first line of a frame narrower than the first glyph, trailing spaces, and random
-- texts. A frame of 0 does not wrap. GetTextBoundsAsync measures the same (checked for some). A server answers (0, 0) (--server).
local TextService = game:GetService("TextService")
local F = Enum.Font.FredokaOne
local function Size(Text, S, Width)
	return TextService:GetTextSize(Text, S, F, Vector2.new(if Width > 0 then Width else 1e6, 1e6))
end
