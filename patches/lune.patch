+
+/// The CFrame and the Vector3 of a + or a -.
+fn translation(lua: &Lua, lhs: &LuaValue, rhs: &LuaValue) -> LuaResult<(CFrame, Vec3)> {
+    let this = *userdata_of::<CFrame>(Some(lhs)).ok_or_else(|| invalid_argument(1, None, "CFrame", lhs))?;
