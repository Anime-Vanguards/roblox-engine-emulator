+/// An optional Vector3 argument: none when not passed, else checked as [`vector_arg`] (nil passed is no Vector3).
+fn optional_vector_arg(lua: &Lua, args: &LuaMultiValue, index: usize, name: &str) -> LuaResult<Option<Vec3>> {
