+        if v == 0.0 {
+            return (0.0, 0.0, v);
+        }
+        let x = r.min(g).min(b);
+        let s = (v - x) / v;
+        if s == 0.0 {
+            return (0.0, s, v);
+        }
+        let d = v - x;
+        let (rn, gn, bn) = ((v - r) / d, (v - g) / d, (v - b) / d);
+        let h = if r == v {
+            if g == x { 5.0 + bn } else { 1.0 - gn }
+        } else if g == v {
+            if b == x { 1.0 + rn } else { 3.0 - bn }
+        } else if r == x {
+            3.0 + gn
+        } else {
+            5.0 - rn
+        };
+        (h / 6.0, s, v)
+    }
