+            lua.exec_raw::<LuaFunction>(checked, |state| {
+                mlua::ffi::lua_pushcclosurek(state, fuzzy_eq_c, c"FuzzyEq".as_ptr(), 1, None);
+            })?
+        };
+        Ok(LuaValue::Function(method))
