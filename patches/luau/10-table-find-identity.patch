# Topic: table.find of a table needle by identity
#
# What it does: a needle that is a table without __eq is compared by identity over the array part, with no hash lookup
# and no generic equality.
#
# Why upstream lacks it: a speed-up for the engine's own hot path (the same result as the generic loop).

diff --git a/luau/VM/src/ltablib.cpp b/luau/VM/src/ltablib.cpp
index aafe3a3..ca5b25c 100644
--- a/luau/VM/src/ltablib.cpp
+++ b/luau/VM/src/ltablib.cpp
@@ -11,6 +11,7 @@
 #include "lgc.h"
 #include "ldebug.h"
 #include "lvm.h"
+#include "ltm.h"
 
 static int foreachi(lua_State* L)
 {
@@ -548,6 +549,27 @@ static int tfind(lua_State* L)
     LuaTable* t = hvalue(L->base);
     StkId v = L->base + 1;
 
+    // Without a needle equality metamethod, every table comparison is identity.
+    // The dense array prefix needs neither a hash lookup nor generic equality dispatch.
+    if (ttistable(v) && fasttm(L, hvalue(v)->metatable, TM_EQ) == NULL)
+    {
+        LuaTable* needle = hvalue(v);
+        for (; init <= t->sizearray; ++init)
+        {
+            const TValue* e = &t->array[init - 1];
+            if (ttisnil(e))
+            {
+                lua_pushnil(L);
+                return 1;
+            }
+            if (ttistable(e) && hvalue(e) == needle)
+            {
+                lua_pushinteger(L, init);
+                return 1;
+            }
+        }
+    }
+
     for (int i = init;; ++i)
     {
         const TValue* e = luaH_getnum(t, i);
