# Topic: on-demand single-proto tiered native JIT
#
# What it does:
# Adds luau_codegen_set_tiered(L, threshold) so --native VMs can load large module graphs
# without eagerly JIT-compiling every cold function, compiling individual hot Protos in place
# once they reach 	hreshold invocations (while keeping default work-counted runs untouched).
#
# Why upstream lacks it: upstream luau_codegen_compile compiles an entire chunk tree up front,
# which spends hundreds of milliseconds compiling cold test-framework modules on startup.
diff --git a/luau/CodeGen/include/Luau/CodeGen.h b/luau/CodeGen/include/Luau/CodeGen.h
index b45e217..8088d2b 100644
--- a/luau/CodeGen/include/Luau/CodeGen.h
+++ b/luau/CodeGen/include/Luau/CodeGen.h
@@ -127,6 +127,7 @@ void create(lua_State* L, SharedCodeGenContext* codeGenContext);
 
 // Enable or disable native execution according to `enabled` argument
 void setNativeExecutionEnabled(lua_State* L, bool enabled);
+void setTieredThreshold(lua_State* L, unsigned int threshold);
 
 // Given a name, this function must return the index of the type which matches the type array used all CompilationOptions and AssemblyOptions
 // If the type is unknown, 0xff has to be returned
