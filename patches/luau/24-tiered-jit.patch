index 9de15e6..e81b6e1 100644
--- a/luau/CodeGen/include/luacodegen.h
+++ b/luau/CodeGen/include/luacodegen.h
@@ -16,3 +16,6 @@ LUACODEGEN_API void luau_codegen_create(lua_State* L);
 
 // build target function and all inner functions
 LUACODEGEN_API void luau_codegen_compile(lua_State* L, int idx);
+
+// enable on-demand single-proto native compilation after `threshold` calls (0 disables)
+LUACODEGEN_API void luau_codegen_set_tiered(lua_State* L, unsigned int threshold);
