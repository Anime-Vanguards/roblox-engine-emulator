diff --git a/luau/VM/src/lmathlib.cpp b/luau/VM/src/lmathlib.cpp
index 546725c..5f4f21a 100644
--- a/luau/VM/src/lmathlib.cpp
+++ b/luau/VM/src/lmathlib.cpp
@@ -1,6 +1,7 @@
 // This file is part of the Luau programming language and is licensed under MIT License; see LICENSE.txt for details
 // This code is based on Lua 5.x implementation licensed under MIT License; see lua_LICENSE.txt for details
 #include "lualib.h"
+#include "lbytecode.h"
 
 #include "lstate.h"
 
@@ -477,6 +478,11 @@ int luaopen_math(lua_State* L)
     pcg32_seed(&L->global->rngstate, seed);
 
     luaL_register(L, LUA_MATHLIBNAME, mathlib);
+
+    lua_getfield(L, -1, "floor");
+    if (iscfunction(L->top - 1) && clvalue(L->top - 1)->c.f == math_floor)
+        clvalue(L->top - 1)->builtin = LBF_MATH_FLOOR;
+    lua_pop(L, 1);
     lua_pushnumber(L, PI);
     lua_setfield(L, -2, "pi");
     lua_pushnumber(L, HUGE_VAL);
diff --git a/luau/VM/src/lobject.h b/luau/VM/src/lobject.h
index de24ee2..cf6a2a2 100644
--- a/luau/VM/src/lobject.h
+++ b/luau/VM/src/lobject.h
@@ -388,6 +388,7 @@ typedef struct Closure
     uint8_t nupvalues;
     uint8_t stacksize;
     uint8_t preload;
+    uint8_t builtin; // Canonical C closure fastcall ID; zero for all other closures.
 
     GCObject* gclist;
     struct LuaTable* env;
@@ -410,6 +411,9 @@ typedef struct Closure
     };
 } Closure;
 
+static_assert(offsetof(Closure, builtin) == 7, "builtin tag must use existing closure padding");
+static_assert(offsetof(Closure, gclist) == 8, "closure pointer layout must remain unchanged");
+
 #define iscfunction(o) (ttype(o) == LUA_TFUNCTION && clvalue(o)->isC)
 #define isLfunction(o) (ttype(o) == LUA_TFUNCTION && !clvalue(o)->isC)
 
