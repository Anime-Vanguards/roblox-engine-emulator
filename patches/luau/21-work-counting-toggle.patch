# Topic: toggleable VM work counters
#
# What it does: lua_setworkcounting(L, on) disables per-instruction, per-allocation and per-call
# work counting (global_State::workoff, stored in existing padding before gray so global_State keeps
# its size) and dispatches the interpreter to an uncounted luau_execute specialization when off.
# Defaults to on so existing callers see identical counts and GC pacing.
#
# Why upstream lacks it: work counters are an emulator patch (02-work-counters.patch); test runs
# that do not use the work clock can run natively without paying the counter overhead.
diff --git a/luau/VM/include/lua.h b/luau/VM/include/lua.h
index d4c1c25..0a320a8 100644
--- a/luau/VM/include/lua.h
+++ b/luau/VM/include/lua.h
@@ -398,6 +398,8 @@ LUA_API void lua_workhostcalls(lua_State* L, int calls);
 LUA_API void lua_workhostnanos(lua_State* L, int nanos);
 // on: one more level of muting; off: one less (the engine's Luau prices a whole call itself, as Scheduler.muted does for the host's charges)
 LUA_API void lua_workmute(lua_State* L, int on);
+// turns the VM's work counters on or off (default on); off, scripts run without per-instruction or per-allocation counting
+LUA_API void lua_setworkcounting(lua_State* L, int on);
 // the clock the garbage collector paces itself by, in seconds (it measures the allocation rate and the mark phase's length with it to
 // set the next cycle's trigger): the wall clock (lua_clock) by default, so where it steps depends on how fast the host ran; a host
 // that must collect at the same points in every run gives it a clock of the work done instead. NULL restores the wall clock.
diff --git a/luau/VM/src/lapi.cpp b/luau/VM/src/lapi.cpp
index ecb7d04..fefea22 100644
--- a/luau/VM/src/lapi.cpp
+++ b/luau/VM/src/lapi.cpp
@@ -1581,6 +1581,11 @@ void lua_workmute(lua_State* L, int on)
         --muted;
 }
 
+void lua_setworkcounting(lua_State* L, int on)
+{
+    L->global->workoff = on ? 0 : 1;
+}
+
 void lua_setgcclock(lua_State* L, double (*clock)(void* ud), void* ud)
 {
     L->global->gcclock = clock;
