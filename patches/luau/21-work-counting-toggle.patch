+    uint8_t workoff; // work counters disabled (lua_setworkcounting; in the same padding)
 
     GCObject* gray;      // list of gray objects
     GCObject* grayagain; // list of objects to be traversed atomically
@@ -406,7 +407,7 @@ union GCObject
