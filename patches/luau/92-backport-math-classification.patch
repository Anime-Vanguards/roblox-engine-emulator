# Topic: backport: math.isnan, math.isinf and math.isfinite
#
# What it does: Luau's number classifiers, as library functions and as fast-called builtins (the compiler's builtin
# ids, constant folding and type inference, the native code's analysis).
#
# Upstream: 0.708 (behind FFlagLuauMathIsNanInfFinite from 0.701)

diff --git a/luau/CodeGen/src/BytecodeAnalysis.cpp b/luau/CodeGen/src/BytecodeAnalysis.cpp
index 3ea22f3..627f967 100644
--- a/luau/CodeGen/src/BytecodeAnalysis.cpp
+++ b/luau/CodeGen/src/BytecodeAnalysis.cpp
@@ -560,6 +560,18 @@ static void applyBuiltinCall(LuauBuiltinFunction bfid, BytecodeTypes& types)
         types.b = LBC_TYPE_NUMBER;
         types.c = LBC_TYPE_NUMBER;
         break;
+    case LBF_MATH_ISNAN:
+        types.result = LBC_TYPE_BOOLEAN;
+        types.a = LBC_TYPE_NUMBER;
+        break;
+    case LBF_MATH_ISINF:
+        types.result = LBC_TYPE_BOOLEAN;
+        types.a = LBC_TYPE_NUMBER;
+        break;
+    case LBF_MATH_ISFINITE:
+        types.result = LBC_TYPE_BOOLEAN;
+        types.a = LBC_TYPE_NUMBER;
+        break;
     }
 }
 
diff --git a/luau/CodeGen/src/OptimizeConstProp.cpp b/luau/CodeGen/src/OptimizeConstProp.cpp
