# Topic: safe-sandbox setfenv preservation for native codegen
#
# What it does: marks chunks compiled with sandbox-mutable globals (LUAU_PROTO_SAFE_SANDBOX via
# lua_setsafesandbox) and lets luaB_setfenv mark a verified sandbox environment with safeenv = 2
# when its __index chain and metatables are readonly, its existing keys are whitelisted sandbox
# keys, and it inherits from the VM's readonly safe global base (lua_setsafeglobalbase). Any new
# key insertion (luaH_newkey/luaH_setstr), metatable swap (lua_setmetatable), or getfenv clears
# safeenv = 2 back to 0 without affecting stock safeenv = 1 environments.
#
# Why upstream lacks it: test harnesses that run modules through debug.loadmodule and setfenv
# would otherwise lose safeenv, disabling VM fastcalls and native codegen for every tested module.
diff --git a/luau/VM/include/lua.h b/luau/VM/include/lua.h
index 0a320a8..2f54f66 100644
--- a/luau/VM/include/lua.h
+++ b/luau/VM/include/lua.h
@@ -400,6 +400,10 @@ LUA_API void lua_workhostnanos(lua_State* L, int nanos);
 LUA_API void lua_workmute(lua_State* L, int on);
 // turns the VM's work counters on or off (default on); off, scripts run without per-instruction or per-allocation counting
 LUA_API void lua_setworkcounting(lua_State* L, int on);
+// marks a Luau function and its nested protos as compiled for safe-sandbox setfenv preservation (mutable sandbox globals)
+LUA_API void lua_setsafesandbox(lua_State* L, int idx);
+// sets the immutable shared global base table for safe-sandbox setfenv preservation (nil disables)
+LUA_API void lua_setsafeglobalbase(lua_State* L, int idx);
 // the clock the garbage collector paces itself by, in seconds (it measures the allocation rate and the mark phase's length with it to
 // set the next cycle's trigger): the wall clock (lua_clock) by default, so where it steps depends on how fast the host ran; a host
 // that must collect at the same points in every run gives it a clock of the work done instead. NULL restores the wall clock.
diff --git a/luau/VM/src/lapi.cpp b/luau/VM/src/lapi.cpp
index fefea22..792d836 100644
--- a/luau/VM/src/lapi.cpp
+++ b/luau/VM/src/lapi.cpp
@@ -1052,6 +1052,8 @@ int lua_setmetatable(lua_State* L, int objindex)
     {
         if (hvalue(obj)->readonly)
             luaG_readonlyerror(L);
+        if (LUAU_UNLIKELY(hvalue(obj)->safeenv == 2))
+            hvalue(obj)->safeenv = 0;
         hvalue(obj)->metatable = mt;
         if (mt)
             luaC_objbarrier(L, hvalue(obj), mt);
@@ -1586,6 +1588,32 @@ void lua_setworkcounting(lua_State* L, int on)
     L->global->workoff = on ? 0 : 1;
 }
 
+static void setsafesandbox(Proto* p)
+{
+    p->flags |= LUAU_PROTO_SAFE_SANDBOX;
+    for (int i = 0; i < p->sizep; ++i)
+        setsafesandbox(p->p[i]);
+}
+
+void lua_setsafesandbox(lua_State* L, int idx)
+{
+    const TValue* o = index2addr(L, idx);
+    api_check(L, isLfunction(o));
+    setsafesandbox(clvalue(o)->l.p);
+}
+
+void lua_setsafeglobalbase(lua_State* L, int idx)
+{
+    const TValue* o = index2addr(L, idx);
+    if (ttisnil(o))
+    {
+        L->global->safebase = NULL;
+        return;
+    }
+    api_check(L, ttistable(o));
+    L->global->safebase = hvalue(o);
+}
+
 void lua_setgcclock(lua_State* L, double (*clock)(void* ud), void* ud)
 {
     L->global->gcclock = clock;
