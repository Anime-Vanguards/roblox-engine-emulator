+static LUAU_FORCEINLINE int ctz64(uint64_t v)
+{
+#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_ARM64))
+    unsigned long idx;
+    _BitScanForward64(&idx, v);
+    return int(idx);
+#elif defined(__GNUC__) || defined(__clang__)
+    return __builtin_ctzll(v);
+#else
+    int idx = 0;
+    while ((v & 1) == 0)
+    {
+        v >>= 1;
+        idx++;
+    }
+    return idx;
+#endif
