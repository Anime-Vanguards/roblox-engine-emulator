# Topic: dirty bitmask and hot-path optimizations for the stepping profiler
#
# What it does: adds a 64-bit workdirty bitmask in global_State (reclaiming existing padding
# by packing floatmode/floatchanged/tiered_on_load next to ptrencactive so sizeof(global_State)
# and totalbytes stay unchanged across all vector-size and GC-metrics configurations), with bit
# positions in strictly ascending lua_WorkCounters slot order so every non-opcode scalar counter
# write marks its bit and book(s, L) only inspects dirty slots in the exact order of its previous
# full scan. Splits book() into an inline pure-Luau fast path (skipping stack-array zeroing,
# hostkinds loops, and zero-kind split writes when no scalar or host work moved) and an
# out-of-line bookSlow(), gates bookcallee() on a 3-bit calleeMask, caches the active phase id
# on ProfFunction for inline phaselinesof(), and places a 1024-bit Bloom filter + 64-entry
# direct-mapped cache in front of coldframe hash lookups in luaP_step().
#
# Why upstream lacks it: the stepping work profiler (12-profiling) and its scalar counters
# are emulator-specific patches.
diff --git a/luau/VM/src/lapi.cpp b/luau/VM/src/lapi.cpp
index 2a25af6..b57bfad 100644
--- a/luau/VM/src/lapi.cpp
+++ b/luau/VM/src/lapi.cpp
@@ -1589,7 +1589,10 @@ void lua_workhostcalls(lua_State* L, int calls)
     if (L->global->workoff)
         return;
     if (luaE_scriptwork(L))
+    {
         L->global->work.hostcalls += calls;
+        luaE_workmarkbit(L->global, LUA_WBIT_HOSTCALLS);
+    }
 }
 
 void lua_workhostnanos(lua_State* L, int nanos)
@@ -1598,16 +1601,25 @@ void lua_workhostnanos(lua_State* L, int nanos)
         return;
     // (also for a constructor the engine's wrapper calls for a script: the host's work for a script)
     if (L->global->work.muted == 0 && luaE_workframe(L, L->ci) != 0)
+    {
         L->global->work.hostnanos += nanos;
+        luaE_workmarkbit(L->global, LUA_WBIT_HOSTNANOS);
+    }
 }
 
 void lua_workmute(lua_State* L, int on)
 {
     uint64_t& muted = L->global->work.muted;
     if (on)
+    {
         ++muted;
+        luaE_workmarkbit(L->global, LUA_WBIT_MUTED);
+    }
     else if (muted > 0)
+    {
         --muted;
+        luaE_workmarkbit(L->global, LUA_WBIT_MUTED);
+    }
 }
 
