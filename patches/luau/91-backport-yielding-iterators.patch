# Topic: backport: a generic for's iterator can yield
#
# What it does: a Luau iterator of a generic for runs as a frame of the interpreter (its return finishes the loop
# step), so it can yield, as a Roblox client lets it.
#
# Upstream: 0.735 (behind FFlagLuauYieldIter2 from 0.722)

diff --git a/luau/VM/src/lstate.h b/luau/VM/src/lstate.h
index 1a6927b..39fbdc3 100644
--- a/luau/VM/src/lstate.h
+++ b/luau/VM/src/lstate.h
@@ -70,6 +70,7 @@ typedef struct CallInfo
 #define LUA_CALLINFO_RETURN (1 << 0) // should the interpreter return after returning from this callinfo? first frame must have this set
 #define LUA_CALLINFO_HANDLE (1 << 1) // should the error thrown during execution get handled by continuation from this callinfo? func must be C
 #define LUA_CALLINFO_NATIVE (1 << 2) // should this function be executed using execution callback for native code
+#define LUA_CALLINFO_FORGLOOP (1 << 3) // the iterator of the caller's FORGLOOP (savedpc at its aux): its return finishes the loop step, so it can yield as in Roblox
 
 #define curr_func(L) (clvalue(L->ci->func))
 #define ci_func(ci) (clvalue((ci)->func))
diff --git a/luau/VM/src/lvmexecute.cpp b/luau/VM/src/lvmexecute.cpp
index 0ee5213..c6ed8fc 100644
--- a/luau/VM/src/lvmexecute.cpp
+++ b/luau/VM/src/lvmexecute.cpp
@@ -1092,6 +1092,24 @@ reentry:
                 Closure* nextcl = clvalue(cip->func);
                 Proto* nextproto = nextcl->l.p;
 
+                // the iterator of a FORGLOOP returned: finish that loop step as the luaD_call path does
+                if (LUAU_UNLIKELY(ci->flags & LUA_CALLINFO_FORGLOOP))
+                {
+                    Instruction loopinsn = cip->savedpc[-1];
+                    StkId loopra = cip->base + LUAU_INSN_A(loopinsn);
+
+                    // copy first variable back into the iteration index
+                    setobj2s(L, loopra + 2, loopra + 3);
+
+                    pc = cip->savedpc + (ttisnil(loopra + 3) ? 1 : LUAU_INSN_D(loopinsn));
+                    cl = nextcl;
+                    workops = luaE_workops(L, cl);
+                    base = L->base;
+                    k = nextproto->k;
+                    LUAU_ASSERT(unsigned(pc - cl->l.p->code) < unsigned(cl->l.p->sizecode));
+                    VM_NEXT();
+                }
+
 #if VM_HAS_NATIVE
                 if (LUAU_UNLIKELY((cip->flags & LUA_CALLINFO_NATIVE) && (!SingleStep || luaP_native(L))))
                 {
@@ -2462,6 +2480,49 @@ reentry:
                     L->top = ra + 3 + 3; // func + 2 args (state and index)
                     LUAU_ASSERT(L->top <= L->stack_last);
 
+                    // a Luau iterator runs as a frame of this interpreter, not a C call, so it can yield (Roblox's VM lets
+                    // it); its LOP_RETURN finishes this step (LUA_CALLINFO_FORGLOOP). It runs interpreted (p->code).
+                    if (ttisfunction(ra) && !clvalue(ra)->isC)
+                    {
+                        Closure* ccl = clvalue(ra);
+                        Proto* p = ccl->l.p;
+                        L->ci->savedpc = pc;
+
+                        CallInfo* ci = incr_ci(L);
+                        ci->func = ra + 3;
+                        ci->base = ra + 3 + 1;
+                        ci->top = L->top + ccl->stacksize;
+                        ci->savedpc = NULL;
+                        ci->flags = LUA_CALLINFO_FORGLOOP;
+                        ci->nresults = uint8_t(aux);
+
+                        L->base = ci->base;
+
+                        // reallocs the stack: ra is not used after this line
+                        luaD_checkstackfornewci(L, ccl->stacksize);
+                        LUAU_ASSERT(ci->top <= L->stack_last);
+
+                        StkId argi = L->top;
+                        StkId argend = L->base + p->numparams;
+                        while (argi < argend)
+                            setnilvalue(argi++);
+                        L->top = p->is_vararg ? argi : ci->top;
+
+                        pc = p->code;
+                        if ((p->flags & LUAU_PROTO_WORK_EXEMPT) && !(cl->l.p->flags & LUAU_PROTO_WORK_EXEMPT))
+                        {
+                            L->global->work.hostcalls++;
+                            luaC_coldcall(L, ccl, 1, NULL, cl->l.p);
+                        }
+                        cl = ccl;
+                        workops = luaE_workops(L, cl);
+                        luaC_touch(L, cl);
+                        luaC_touch(L, p);
+                        base = L->base;
+                        k = p->k;
+                        VM_NEXT();
+                    }
+
                     VM_PROTECT(luaD_call(L, ra + 3, uint8_t(aux)));
                     L->top = L->ci->top;
 
