# Topic: engine functions: one call each, priced as the function they stand for
#
# What it does: lua_setenginecfunction marks a host's C function (process-wide, a host function too) as an engine function: a
# C function each closure of which stands for one function of the engine a script calls, doing that function's work from inside
# (a host's callback, or its own Luau). A script's call of one is one call: a C call (work.ccalls) for a library's function, and
# for one marked `served`, which stands for an operation the host serves (a datatype's constructor, an object's method), the host
# call (work.hostcalls) the host's own Luau that stood for it was. Its first call in a frame is a C function's
# (LUA_WORK_COLDCFUNCS), or for a served one the host Luau's (LUA_WORK_COLDHOSTFUNCS); one that is a metamethod (luaV_callTM, which
# prices no C function) is priced so too. What it runs for the call is part of it: the
# host's own Luau, with no host call and no first call of its own when the engine function was charged as the script's call
# (LUA_CALLINFO_WORK_CCALL), and a C function it calls, however the engine function was called. A C closure's kind is kept in its
# preload byte (1 a library function, 2 a host function, 3 an engine function, 4 a served one), where the host functions'
# classification already was.
#
# Why upstream lacks it: upstream has no work counters. A host that serves engine functions through its own Luau (so they may
# yield and raise at the script's level) shows a script frames a real engine has not: a real engine's engine functions are C
# functions, `[C]` with their names in debug.info and no frame of their own in a traceback. A host closure in C over that work
# shows what a real engine does, and this keeps the closure's call priced as the one call it stands for.

diff --git a/luau/VM/include/lua.h b/luau/VM/include/lua.h
index 3f89a6c..d4c1c25 100644
--- a/luau/VM/include/lua.h
+++ b/luau/VM/include/lua.h
@@ -457,6 +457,14 @@ LUA_API void lua_coldframe(lua_State* L);
 LUA_API void lua_sethostcfunction(lua_CFunction f);
 // marks `count` functions at once, and `trampoline` (the one C function a host's closures made from Rust share), taking the lock once
 LUA_API void lua_sethostcfunctions(const lua_CFunction* functions, int count, lua_CFunction trampoline);
+// marks `f` as a host's engine function (process-wide, a host function too): a C function each closure of which stands for one
+// function of the engine a script calls, doing its work from inside (a host's callback, its own Luau). A script's call of one is
+// one C call: the host's own Luau it runs for that call is part of it (no host call of its own, and no first call in a frame of its
+// own), and so is a C function it calls, however it was called. `served` marks one standing for an operation the host serves rather
+// than a library function (a datatype's constructor, an object's method): a script's call of it is counted as the host call
+// (work.hostcalls) and its first call in a frame as the host Luau's first call (LUA_WORK_COLDHOSTFUNCS) the host's own Luau that
+// stood for it was. A host has a few: at most 8.
+LUA_API void lua_setenginecfunction(lua_CFunction f, int served);
 
 // the names a host's typeof gives its own values, for the builtin typeof (a script's fast call) to give them too: the table at
 // `idx` maps a table or a userdata to its name, looked up before the value's own type name, and `vectorname` (NULL: none) names
diff --git a/luau/VM/src/lapi.cpp b/luau/VM/src/lapi.cpp
index 553d611..ecb7d04 100644
--- a/luau/VM/src/lapi.cpp
+++ b/luau/VM/src/lapi.cpp
@@ -1490,6 +1490,45 @@ void lua_sethostcfunctions(const lua_CFunction* functions, int count, lua_CFunct
     hostcfunctioncount.store(registered, std::memory_order_release);
 }
 
+// The host's engine functions (lua_setenginecfunction), with their kinds: a fixed list, published as the host functions are
+static const int kEngineFunctions = 8;
+static lua_CFunction enginecfunctions[kEngineFunctions] = {};
+static uint8_t enginecfunctionkinds[kEngineFunctions] = {};
+static std::atomic<int> enginecfunctioncount{0};
+
+void lua_setenginecfunction(lua_CFunction f, int served)
+{
+    {
+        std::lock_guard<std::mutex> guard(hostcfunctionlock);
+        int count = enginecfunctioncount.load(std::memory_order_relaxed);
+        for (int i = 0; i < count; ++i)
+            if (enginecfunctions[i] == f)
+                return;
+        LUAU_ASSERT(count < kEngineFunctions);
+        if (count == kEngineFunctions)
+            return;
+        enginecfunctions[count] = f;
+        enginecfunctionkinds[count] = served ? LUAE_SERVEDCFUNCTION : LUAE_ENGINECFUNCTION;
+        enginecfunctioncount.store(count + 1, std::memory_order_release);
+    }
+    lua_sethostcfunction(f);
+}
+
+int luaE_cfunctionkind(Closure* cl)
+{
+    // (the answer is kept in the C closure's preload byte, which only Luau closures use and luaF_newCclosure zeroes; a host marks
+    // its functions before its scripts run, as the closures it checks are its scripts')
+    if (cl->preload)
+        return cl->preload;
+    int engines = enginecfunctioncount.load(std::memory_order_acquire);
+    for (int i = 0; i < engines; ++i)
+        if (enginecfunctions[i] == cl->c.f)
+            return cl->preload = enginecfunctionkinds[i];
+    size_t count = hostcfunctioncount.load(std::memory_order_acquire);
+    cl->preload = hostfunctionregistered(cl->c.f, count) ? LUAE_HOSTCFUNCTION : LUAE_LIBRARYCFUNCTION;
+    return cl->preload;
+}
+
 bool luaE_hostcall(lua_State* L)
 {
     if (!L->stack || L->ci <= L->base_ci || !ttisfunction(L->ci->func))
@@ -1497,14 +1536,7 @@ bool luaE_hostcall(lua_State* L)
     Closure* cl = clvalue(L->ci->func);
     if (!cl->isC)
         return false;
-    // (the answer is kept in the C closure's preload byte, which only Luau closures use and luaF_newCclosure zeroes: 1 a library
-    // function, 2 a host's; a host marks its functions before its scripts run, as the closures it checks are its scripts')
-    if (cl->preload)
-        return cl->preload == 2;
-    size_t count = hostcfunctioncount.load(std::memory_order_acquire);
-    bool host = hostfunctionregistered(cl->c.f, count);
-    cl->preload = host ? 2 : 1;
-    return host;
+    return luaE_cfunctionkind(cl) >= LUAE_HOSTCFUNCTION;
 }
 
