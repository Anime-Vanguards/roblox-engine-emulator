local function F(Value)
	return string.format("%.17g", Value)
end
local function V(Value)
	assert(typeof(Value) == "Vector3" and type(Value) == "vector", "not a native Vector3")
	return F(Value.X) .. " " .. F(Value.Y) .. " " .. F(Value.Z)
end
local function C(Value)
	assert(typeof(Value) == "CFrame", "not a CFrame")
	local Parts = { Value:GetComponents() }
	for Index, Part in Parts do
		Parts[Index] = F(Part)
	end
	return table.concat(Parts, " ")
end
local function Err(Callback, ...)
	local Ok, Message = pcall(Callback, ...)
	assert(not Ok, "no error")
	local Text = string.match(tostring(Message), "^(.-)\nstack traceback:") or tostring(Message)
	return (string.gsub(Text, "^[^:]*:%d+: ", ""))
end

local A = CFrame.new(1, 2, 3) * CFrame.Angles(0.3, 0.4, 0.5)
