
return function(Context)
	local Players = game:GetService("Players")
	local Http = game:GetService("HttpService")
	local P = Players.LocalPlayer
	local function Try(F, ...)
		local Ok, A, B = pcall(F, ...)
		if Ok then
			return tostring(A) .. (if B ~= nil then " " .. tostring(B) else "")
		end
		return "!" .. tostring(A)
	end
	-- (a value as JSON on a line of its own, or what the call raised)
	local function Json(Label, F, ...)
		local Ok, Value = pcall(F, ...)
		print(Label, if Ok then Http:JSONEncode(Value) else "!" .. tostring(Value))
	end
	print("player", P.Name, P.DisplayName, P.UserId, P.AccountAge, P.MembershipType, P.HasVerifiedBadge, P.LocaleId, P.FollowUserId)
	local UIS = game:GetService("UserInputService")
	print("inputs", UIS.KeyboardEnabled, UIS.MouseEnabled, UIS.TouchEnabled, UIS.GamepadEnabled, UIS.AccelerometerEnabled, UIS.GyroscopeEnabled, UIS.VREnabled)
	print("input", UIS.PreferredInput, UIS:GetLastInputType())
	local GS = game:GetService("GuiService")
	print("gui", GS:IsTenFootInterface(), (GS:GetGuiInset()), GS.TopbarInset, GS.PreferredTextSize, GS.PreferredTransparency, GS.ReducedMotionEnabled)
	print("screen", workspace.CurrentCamera.ViewportSize, GS:GetInsetArea(Enum.ScreenInsets.CoreUISafeInsets))
	local Settings = UserSettings():GetService("UserGameSettings")
	print("settings", Settings.SavedQualityLevel, Settings:GetCameraYInvertValue())
	print("vr", game:GetService("VRService").VREnabled)
	local LS = game:GetService("LocalizationService")
	print("locale", LS.RobloxLocaleId, LS.SystemLocaleId, LS:GetCountryRegionForPlayerAsync(P))
	print("game", game.PlaceId, game.GameId, game.CreatorId, game.CreatorType, game.JobId, game.PlaceVersion, game.PrivateServerId, game.PrivateServerOwnerId, workspace.StreamingEnabled)
	-- (the link list by its length)
	Json("policy", function()
		local Policy = game:GetService("PolicyService"):GetPolicyInfoForPlayerAsync(P)
		Policy.AllowedExternalLinkReferences = #Policy.AllowedExternalLinkReferences
		return Policy
	end)
	local MS = game:GetService("MarketplaceService")
	print("owns", MS:UserOwnsGamePassAsync(P.UserId, 11), MS:UserOwnsGamePassAsync(P.UserId, 12), MS:PlayerOwnsAsset(P, 21), MS:PlayerOwnsAsset(P, 22), MS:PlayerOwnsBundle(P, 31))
	print("owns async", Try(MS.PlayerOwnsAssetAsync, MS, P, 21))
	Json("subscription", function() return MS:GetUserSubscriptionStatusAsync(P, "EXP-1") end)
	local BS = game:GetService("BadgeService")
	print("badges", BS:UserHasBadgeAsync(P.UserId, 41), BS:UserHasBadgeAsync(P.UserId, 42))
	Json("badge list", function() return BS:CheckUserBadgesAsync(P.UserId, { 42, 41 }) end)
	print("groups", P:IsInGroup(7), P:GetRankInGroup(7), P:GetRoleInGroup(7), P:IsInGroupAsync(8), P:GetRankInGroupAsync(8), P:GetRoleInGroupAsync(8))
	Json("group list", function() return game:GetService("GroupService"):GetGroupsAsync(P.UserId) end)
	print("friends", P:IsFriendsWith(2), P:IsFriendsWith(3))
	Json("online", function() return P:GetFriendsOnline() end)
	local Pages = Players:GetFriendsAsync(P.UserId)
	print("friend pages", Pages.IsFinished)
	Json("friend page", function() return Pages:GetCurrentPage() end)
	print("names", Players:GetNameFromUserIdAsync(P.UserId), Try(Players.GetNameFromUserIdAsync, Players, 2), Players:GetUserIdFromNameAsync(P.Name), Players:GetUserIdFromNameAsync("Bo"))
	Json("infos", function() return game:GetService("UserService"):GetUserInfosByUserIdsAsync({ P.UserId, 2 }) end)
	Json("blocked", function() return game:GetService("StarterGui"):GetCore("GetBlockedUserIds") end)
	print("player calls", P:IsVerified(), P:GetNetworkPing())
	print("@done")
end
